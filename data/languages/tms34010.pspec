<?xml version="1.0" encoding="UTF-8"?>

<!-- TMS34010. Ghidra addresses are bit addresses divided by 8 (see tms34010.slaspec). -->
<processor_spec>
  <programcounter register="PC"/>
  <register_data>
    <register name="MMP" hidden="true"/>
    <register name="STX" hidden="true"/>
    <register name="_B15" hidden="true"/>
  </register_data>
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="ram" first="0x18000000" last="0x1800003f"/>
  </volatile>
  <default_symbols>
    <symbol name="HESYNC" address="ram:0x18000000"/>
    <symbol name="HEBLNK" address="ram:0x18000002"/>
    <symbol name="HSBLNK" address="ram:0x18000004"/>
    <symbol name="HTOTAL" address="ram:0x18000006"/>
    <symbol name="VESYNC" address="ram:0x18000008"/>
    <symbol name="VEBLNK" address="ram:0x1800000a"/>
    <symbol name="VSBLNK" address="ram:0x1800000c"/>
    <symbol name="VTOTAL" address="ram:0x1800000e"/>
    <symbol name="DPYCTL" address="ram:0x18000010"/>
    <symbol name="DPYSTRT" address="ram:0x18000012"/>
    <symbol name="DPYINT" address="ram:0x18000014"/>
    <symbol name="CONTROL" address="ram:0x18000016"/>
    <symbol name="HSTDATA" address="ram:0x18000018"/>
    <symbol name="HSTADRL" address="ram:0x1800001a"/>
    <symbol name="HSTADRH" address="ram:0x1800001c"/>
    <symbol name="HSTCTLL" address="ram:0x1800001e"/>
    <symbol name="HSTCTLH" address="ram:0x18000020"/>
    <symbol name="INTENB" address="ram:0x18000022"/>
    <symbol name="INTPEND" address="ram:0x18000024"/>
    <symbol name="CONVSP" address="ram:0x18000026"/>
    <symbol name="CONVDP" address="ram:0x18000028"/>
    <symbol name="PSIZE" address="ram:0x1800002a"/>
    <symbol name="PMASK" address="ram:0x1800002c"/>
    <symbol name="RESERVED_170" address="ram:0x1800002e"/>
    <symbol name="RESERVED_180" address="ram:0x18000030"/>
    <symbol name="RESERVED_190" address="ram:0x18000032"/>
    <symbol name="RESERVED_1A0" address="ram:0x18000034"/>
    <symbol name="DPYTAP" address="ram:0x18000036"/>
    <symbol name="HCOUNT" address="ram:0x18000038"/>
    <symbol name="VCOUNT" address="ram:0x1800003a"/>
    <symbol name="DPYADR" address="ram:0x1800003c"/>
    <symbol name="REFCNT" address="ram:0x1800003e"/>
    <symbol name="VECTOR_RESET" address="ram:0x1ffffffc"/>
    <symbol name="VECTOR_INT1" address="ram:0x1ffffff8"/>
    <symbol name="VECTOR_INT2" address="ram:0x1ffffff4"/>
