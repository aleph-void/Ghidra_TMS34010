    <symbol name="VECTOR_TRAP6" address="ram:0x1fffffe4"/>
    <symbol name="VECTOR_TRAP7" address="ram:0x1fffffe0"/>
    <symbol name="VECTOR_NMI" address="ram:0x1fffffdc"/>
    <symbol name="VECTOR_HI" address="ram:0x1fffffd8"/>
    <symbol name="VECTOR_DI" address="ram:0x1fffffd4"/>
    <symbol name="VECTOR_WV" address="ram:0x1fffffd0"/>
    <symbol name="VECTOR_TRAP12" address="ram:0x1fffffcc"/>
